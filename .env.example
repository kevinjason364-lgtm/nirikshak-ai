# Nirikshak AI - Prototype Configuration
# No API keys, credentials, or secrets required for the prototype.

NEXT_PUBLIC_APP_MODE=prototype
NEXT_PUBLIC_ENABLE_CAMERA=true
NEXT_PUBLIC_STORAGE_MODE=local

# ============================================
# Vision AI Extraction (Server-Side Only)
# ============================================
# These environment variables are used ONLY on the server side.
# NEVER use NEXT_PUBLIC_ prefix for API keys!

# Vision AI Provider: 'gemini' (currently supported)
VISION_PROVIDER=gemini

# Vision AI Model: gemini-1.5-flash-latest (default), gemini-2.0-flash-exp, gemini-1.5-pro-latest
VISION_MODEL=gemini-1.5-flash-latest

# Vision AI API Key (get from Google AI Studio: https://aistudio.google.com/app/apikey)
# VISION_API_KEY=your-api-key-here

# Free Tier Limits (Gemini 1.5 Flash):
# - 15 requests per minute (RPM)
# - 1 million tokens per minute (TPM)
# - 1,500 requests per day (RPD)
# ============================================
